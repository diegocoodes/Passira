# Local development, without access to production data:
DATABASE_URL="file:./prisma/dev.db"
# Hostinger Node.js: use the full database/user names, including the account prefix.
# DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"
# Encode special characters in the user and password with percent encoding.
# External MySQL: add ?sslaccept=strict to require verified TLS.
# PostgreSQL remains supported:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Required when creating the first administrator in production.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
